{
  "expo": {
    "name": "Impostor RMR",
    "slug": "impostor-app",
    "scheme": "impostor",
    "owner": "roy_m",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./src/assets/ic_launcher.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/ic_launcher.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roysmr.impostor"
    },
    "android": {
      "package": "com.roysmr.impostor",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/ic_launcher.png",
        "backgroundColor": "#0A0F1E"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "27182487-eef8-4b68-9c49-e535e878bb70"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
